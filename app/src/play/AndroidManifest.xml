<?xml version="1.0" encoding="utf-8"?>
<!-- Solo para la versión de Play Store (-Pplay): Play no permite que la app se actualice por fuera de la tienda. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <application>
        <service android:name="pe.cooruta.app.ServicioDescarga" tools:node="remove" />
    </application>
</manifest>
